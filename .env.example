# Copy to .env.local for local ingester runs. Never commit real values.

# --- Ingester (server-side; used by scripts/ingest and GitHub Actions) ---
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service-role key bypasses RLS. Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Lovable app (client-side; VITE_ prefix is required for Vite to expose them) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon key — safe to ship to the browser. Restricted by RLS.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# PostHog project API key (starts with phc_)
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com
